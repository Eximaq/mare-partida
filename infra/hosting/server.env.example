NODE_ENV=production
HOST=127.0.0.1
PORT=8787
TRUSTED_PROXY_IP=127.0.0.1
AUTH_ENABLED=true
AUTH_PUBLIC_ORIGIN=https://game.example.invalid
DATABASE_URL=postgresql://mare_runtime:REPLACE_LOCALLY@127.0.0.1:5432/mare_dev
SUPABASE_URL=https://REPLACE.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_LOCALLY
SUPABASE_JWT_ALGORITHM=ES256
AUTH_ENCRYPTION_KEY=REPLACE_LOCALLY
SESSION_ABSOLUTE_SECONDS=86400
SESSION_IDLE_SECONDS=7200
PROVIDER_RECHECK_SECONDS=900

# Optional registration gate: SHA-256 of a high-entropy shared invitation code.
# Keep the actual code outside Git. Existing game accounts keep normal login.
# SIGNUP_INVITE_CODE_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_DIGITS

# Bounded CPU workers: API pool 10 + 1 connection per worker.
SIMULATION_SOLO_WORKERS=2
SIMULATION_PARTY_WORKERS=1
