[Unit]
Description=Mare local operational probe
After=mare-server.service
[Service]
Type=oneshot
User=mare
Group=mare
WorkingDirectory=/srv/mare/current
EnvironmentFile=/etc/mare/server.env
ExecStart=/usr/bin/node tools/ops-probe.mts
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
