[Unit]
Description=Mare Partida authoritative API
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
Type=simple
User=mare
Group=mare
WorkingDirectory=/srv/mare/current
EnvironmentFile=/etc/mare/server.env
ExecStart=/usr/bin/node apps/game-server/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096
[Install]
WantedBy=multi-user.target
