# Copy to .env.server.local. Runtime credentials only; keep the generated file ignored.
NODE_ENV=development
HOST=127.0.0.1
PORT=8788
# Examples only. Generate unique local passwords; never commit local env files.
DATABASE_URL=postgresql://mare_runtime:REPLACE_RUNTIME_PASSWORD@127.0.0.1:55433/mare_dev
# Separate migration/test templates: infra/env/*.env.example.
# Auth remains OFF until the owner configures the separate development project.
AUTH_ENABLED=false
AUTH_PUBLIC_ORIGIN=https://localhost:9443
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLISHABLE_KEY_ONLY
SUPABASE_JWT_ALGORITHM=ES256
AUTH_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
# Proposed, configurable policy; never inherit it from client input.
SESSION_ABSOLUTE_SECONDS=604800
SESSION_IDLE_SECONDS=86400
PROVIDER_RECHECK_SECONDS=900
