import {test} from 'node:test';import assert from 'node:assert/strict';import {randomUUID} from 'node:crypto';import {characterCommandSchema} from '@mare/shared';
const e={requestId:randomUUID(),expectedVersion:1,control:{token:'a'.repeat(43),epoch:1}};
test('party intents accept consent and identifiers but reject authority supplied by browser',()=>{for(const [action,payload] of [['party.create',{}],['party.invite',{name:'Marinheiro'}],['party.respond',{inviteId:randomUUID(),accept:true}],['party.prepare',{kind:'hunt',destination:'dawn'}],['party.ready',{nonce:randomUUID(),ready:true}],['party.start',{nonce:randomUUID()}],['party.leave',{}],['party.promote',{memberId:randomUUID()}],['party.kick',{memberId:randomUUID()}]]){assert(characterCommandSchema.safeParse({...e,action,payload}).success,action as string);for(const key of ['ownerId','xp','damage','hp','gold','members','instanceId'])assert(!characterCommandSchema.safeParse({...e,action,payload:{...(payload as object),[key]:999}}).success);}
assert(!characterCommandSchema.safeParse({...e,action:'party.prepare',payload:{kind:'prison',destination:'1'}}).success);});
