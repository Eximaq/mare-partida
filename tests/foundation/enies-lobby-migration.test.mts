import {test} from 'node:test';
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createRequire} from 'node:module';

const require=createRequire(import.meta.url);
const readMigration=(file:string)=>readFileSync(new URL('../../apps/game-server/migrations/'+file,import.meta.url),'utf8');

test('the Enies Lobby fingerprints lead through the additive migrations to shipped rules',()=>{
 const previous=readMigration('0062_enies_lobby.sql');
 const late=readMigration('0063_late_archipelago.sql');
 const swords=readMigration('0064_sword_compendium.sql');
 const skypiea=readMigration('0065_skypiea_celestial_map.sql');
 const arrival=readMigration('0066_skypiea_hd_arrival.sql');
 const loguetown=readMigration('0067_loguetown_hd_map.sql');
 const arlong=readMigration('0068_arlong_park_hd_map.sql');
 const baratie=readMigration('0069_baratie_hd_map.sql');
 const syrup=readMigration('0070_syrup_hd_map.sql');
 const rare=readMigration('0071_rare_island_hd_map.sql');
 const dawn=readMigration('0072_dawn_village_hd_map.sql');
 const conchas=readMigration('0073_conchas_marine_hd_map.sql');
 const orange=readMigration('0074_orange_town_hd_map.sql');
 const alabasta=readMigration('0075_alabasta_desert_hd_map.sql');
 const alubarna=readMigration('0076_alubarna_city_hd_map.sql');
 const world=require('../../world-catalog.cjs').load(),battle=require('../../world-battle.cjs');
 const previousWorld=previous.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 const previousBattle=previous.match(/to_jsonb\('([a-f0-9]{64})'::text\)/)?.[1];
 const lateWorld=late.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 const lateBattle=late.match(/to_jsonb\('([a-f0-9]{64})'::text\)/)?.[1];
 const swordWorld=swords.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 const skypieaWorld=skypiea.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 const arrivalWorld=arrival.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 assert(previousWorld&&previousBattle,'Keep the deployed Enies migration intact');
 assert(lateWorld&&lateBattle,'Keep the deployed late-archipelago migration intact');
 assert(late.includes("WHERE rules_hash='"+previousWorld+"'"),'Recognize saved Enies worlds');
 assert(late.includes("WHERE simulation->>'rulesHash'='"+previousBattle+"'"),'Recognize saved Enies battles');
 assert(swords.includes("WHERE rules_hash='"+lateWorld+"'"),'Recognize worlds after the late-archipelago migration');
 assert(swordWorld&&skypiea.includes("WHERE rules_hash='"+swordWorld+"'"),'Recognize worlds after the sword arena migration');
 assert(skypieaWorld&&arrival.includes("WHERE rules_hash='"+skypieaWorld+"'"),'Recognize worlds after the celestial island migration');
 assert(arrivalWorld&&loguetown.includes("WHERE rules_hash='"+arrivalWorld+"'"),'Recognize worlds after the HD Skypiea arrival migration');
 const loguetownWorld=loguetown.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 assert(loguetownWorld&&arlong.includes("WHERE rules_hash='"+loguetownWorld+"'"),'Recognize worlds after the HD Loguetown migration');
 const arlongWorld=arlong.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 assert(arlongWorld&&baratie.includes("WHERE rules_hash='"+arlongWorld+"'"),'Recognize worlds after the HD Arlong Park migration');
 const baratieWorld=baratie.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 assert(baratieWorld&&syrup.includes("WHERE rules_hash='"+baratieWorld+"'"),'Recognize worlds after the HD Baratie migration');
 const syrupWorld=syrup.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 assert(syrupWorld&&rare.includes("WHERE rules_hash='"+syrupWorld+"'"),'Recognize worlds after the HD Syrup migration');
 const rareWorld=rare.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 assert(rareWorld&&dawn.includes("WHERE rules_hash='"+rareWorld+"'"),'Recognize worlds after the HD Rare island migration');
 const dawnWorld=dawn.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 assert(dawnWorld&&conchas.includes("WHERE rules_hash='"+dawnWorld+"'"),'Recognize worlds after the HD Dawn village migration');
 const conchasWorld=conchas.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 assert(conchasWorld&&orange.includes("WHERE rules_hash='"+conchasWorld+"'"),'Recognize worlds after the HD Conchas migration');
 const orangeWorld=orange.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 assert(orangeWorld&&alabasta.includes("WHERE rules_hash='"+orangeWorld+"'"),'Recognize worlds after the HD Orange Town migration');
 const alabastaWorld=alabasta.match(/SET rules_hash='([a-f0-9]{64})'/)?.[1];
 assert(alabastaWorld&&alubarna.includes("WHERE rules_hash='"+alabastaWorld+"'"),'Recognize worlds after the HD Alabasta desert migration');
 assert(alubarna.includes("SET rules_hash='"+world.rulesHash+"'"),'Migration must promote saved worlds to the shipped catalog hash');
 const savedBattle={rulesHash:lateBattle,hp:17,pending:{targetId:'fixture',remaining:.3}};
 battle.upgradeBalance(savedBattle);
 assert.deepEqual(savedBattle,{rulesHash:battle.rulesHash,hp:17,pending:{targetId:'fixture',remaining:.3}},'Runtime must promote saved battles and preserve the active attack');
});
