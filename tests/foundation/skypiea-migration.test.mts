import {test} from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';import {createRequire} from 'node:module';
const require=createRequire(import.meta.url);
test('Skypiea migration promotes only audited predecessor signatures to the current runtime',()=>{const sql=readFileSync(new URL('../../apps/game-server/migrations/0035_skypiea_catalog.sql',import.meta.url),'utf8');assert(sql.includes('90158f79c9b5101227c40a0f4124617a1bcf08f217892dfa26daab3d90d797d4'));const combat=readFileSync(new URL('../../apps/game-server/migrations/0038_combat_action_compatibility.sql',import.meta.url),'utf8');assert(combat.includes(require('../../world-battle.cjs').rulesHash));assert(combat.includes("WHERE simulation->>'rulesHash'='90158f79c9b5101227c40a0f4124617a1bcf08f217892dfa26daab3d90d797d4'"));const refresh=readFileSync(new URL('../../apps/game-server/migrations/0036_skypiea_map_refresh.sql',import.meta.url),'utf8');assert(refresh.includes(require('../../world-catalog.cjs').load().rulesHash));assert(refresh.includes("WHERE rules_hash='0b25fe7f2b61dc4892d22a7645a262c288dbbdc125ccadd294889016c7cee249'"));assert(sql.includes("WHERE simulation->>'rulesHash'='6ca609c3086bf4062843ebd12d84fc75b5f0cad8307ce0d23454c92101d34e68'"));assert(sql.includes("WHERE rules_hash='65fb208ce5f01adaf0c10618c31efab2d7270e0fae5b44c35dae782ca8235189'"));assert.equal((sql.match(/UPDATE mare_game/g)||[]).length,2);assert(!/DELETE|TRUNCATE|INSERT|ALTER TABLE|DROP TABLE/.test(sql));});
