import {test} from 'node:test';import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';import {createRequire} from 'node:module';
const require=createRequire(import.meta.url);
test('Skypiea migration promotes only audited predecessor signatures to the current runtime',()=>{const sql=readFileSync(new URL('../../apps/game-server/migrations/0035_skypiea_catalog.sql',import.meta.url),'utf8');assert(sql.includes(require('../../world-battle.cjs').rulesHash));assert(sql.includes(require('../../world-catalog.cjs').load().rulesHash));assert(sql.includes("WHERE simulation->>'rulesHash'='6ca609c3086bf4062843ebd12d84fc75b5f0cad8307ce0d23454c92101d34e68'"));assert(sql.includes("WHERE rules_hash='65fb208ce5f01adaf0c10618c31efab2d7270e0fae5b44c35dae782ca8235189'"));assert.equal((sql.match(/UPDATE mare_game/g)||[]).length,2);assert(!/DELETE|TRUNCATE|INSERT|ALTER TABLE|DROP TABLE/.test(sql));});
